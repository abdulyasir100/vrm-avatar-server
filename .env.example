# Avatar Server Environment Configuration
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Options: claude (recommended), groq, lmstudio, ollama, openai, mistral
LLM_PROVIDER=claude
# LLM_BASE_URL=              # leave empty for provider default
# LLM_MODEL=                 # leave empty for provider default (claude=sonnet)
# LLM_API_KEY=               # required for groq/openai, ignored for claude/local

# Fallback chain (tried in order when primary fails).
# Only the provider name and key are read — base_url and model come from the
# provider table in config.py, so the provider must be one it knows:
# groq, openai, mistral, lmstudio, ollama.
# LLM_FALLBACK_1=groq
# LLM_FALLBACK_1_API_KEY=gsk_your_groq_key
# LLM_FALLBACK_2=mistral
# LLM_FALLBACK_2_API_KEY=your_mistral_key

# --- Claude CLI (if LLM_PROVIDER=claude) ---
# CLAUDE_CLI_TIMEOUT=60
# CLAUDE_CLI_EFFORT=medium                        # low, medium, high, max
# CLAUDE_CLI_SMART_MODEL=sonnet                   # model for smart/research mode
# CLAUDE_CLI_SMART_TIMEOUT=120
# CLAUDE_CLI_SMART_TOOLS=WebSearch,WebFetch,Read
# CLAUDE_CLI_CODE_MODEL=opus                      # model for code mode
# CLAUDE_CLI_CODE_TIMEOUT=300
# CLAUDE_CLI_CODE_TOOLS=Bash,Read,Write,Edit,Glob,Grep
# CLAUDE_CLI_SANDBOX_PATH=/home/user/companion-sandbox
# CLAUDE_CLI_SMART_IDLE_ENABLED=true
# CLAUDE_CLI_SMART_IDLE_CHANCE=0.3

# --- Agent CLI Fallback ---
# Second agentic CLI, tried when the primary CLI fails (rate limit, auth,
# outage) before the plain-API chain above. Keeps the full personality and
# tool vocabulary instead of dropping to a terser model. Empty = disabled.
# Auth is owned by the binary: run `opencode auth login` on the host, then
# `opencode auth list` to confirm. No API key belongs here.
# AGENT_CLI_FALLBACK=opencode
# OPENCODE_MODEL=xai/grok-4         # provider/model, per `opencode models`
# OPENCODE_VARIANT=                 # provider reasoning effort, e.g. high
# OPENCODE_TIMEOUT=120
# OPENCODE_AGENT=                   # agent name from opencode.json
# OPENCODE_CODE_MODEL=              # defaults to OPENCODE_MODEL
# OPENCODE_CODE_TIMEOUT=1800
# OPENCODE_BIN=opencode

# --- TTS Engine ---
# Options: cosyvoice (emotion + voice clone), qwen3tts (legacy), kokoro (CPU fallback)
TTS_ENGINE=cosyvoice
COSYVOICE_API_URL=http://your-pc-ip:9091
# COSYVOICE_TIMEOUT=30
# QWEN3TTS_API_URL=http://your-pc-ip:9090
# TTS_MODEL_PATH=models/kokoro-v1_0.onnx
# TTS_VOICE=af_heart

# --- Character ---
# CHARACTER_CARD_PATH=character.json
# PERSONALITY_PROMPT_PATH=prompts/personality.md   # WHO the character is ("" = skip)
# OWNER_PROMPT_PATH=prompts/owner.md               # owner-specific routine/facts ("" = skip)
# SYSTEM_PROMPT_PATH=prompts/system.md             # engine rules, shared by every character
# OWNER_NAME=the user                              # fills {{OWNER_NAME}}; the card's owner.name also works
# OWNER_PRONOUN=they                               # fills {{OWNER_PRONOUN}}; the card's owner.pronoun also works

# --- Locale / Timezone (optional) ---
# TIMEZONE is an IANA name (e.g. Asia/Jakarta, America/New_York, Europe/London).
# Leave empty to use TZ_OFFSET_HOURS instead. TZ_LABEL is an optional short label
# appended to times (e.g. "WIB", "EST"). These can also be set in character.json
# (timezone / tz_label / language / country) — env always wins.
# TIMEZONE=
# TZ_OFFSET_HOURS=0
# TZ_LABEL=
# CHARACTER_LANGUAGE=en
# LOCALE_COUNTRY=

# --- Work connectors (optional plugins) ---
# Google (Gmail + Calendar): create a "Desktop app" OAuth client in Google Cloud Console, enable the
# Gmail and Calendar APIs, then either set the two values below or save the downloaded JSON as
# <PLUGIN_DATA_DIR>/google/client_secret.json. Sign in from Telegram with /p.google.connect.
# Publish the OAuth app (unverified is fine for one user): "Testing" apps expire tokens after 7 days.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Notion: an internal integration token from notion.so/my-integrations; share pages with it.
# NOTION_API_KEY=

# --- Second brain (optional) ---
# Facts and preferences about the owner are shared across characters; relationship and
# event memories stay private to each one. Default: a local SQLite file, nothing to set up.
# Several harnesses share one brain by pointing them all at the same Postgres database:
# BRAIN_BACKEND=postgres
# BRAIN_DSN=postgresql://brain:PASSWORD@host:5432/brain
# BRAIN_PROMPT_MAX=150                 # above this many shared facts, the prompt recalls by message

# --- Second instance (optional) ---
# One checkout can run several characters. Launch each extra one with
#   ENV_FILE=/path/to/instance.env   (read instead of ./.env)
# and give it its own port, roots, card and bot. Everything it writes derives from the roots.
# CHARACTER_ID=second
# AVATAR_SERVER_PORT=8810
# DATA_DIR=/path/to/instance/data      # memory.db, plugin DBs, runtime config, stickers, costumes
# AUDIO_DIR=/path/to/instance/audio
# LOG_DIR=/path/to/instance/logs
# PLUGINS_ENABLED=                     # "" = every enabled plugin | none | csv allowlist
# TTS_VOICE_REF=                       # reference clip path on the TTS server (its ref_audio field)
# SQLITE_WAL=true
# CONTAINER_SUFFIX=-second             # docker compose only: renames the three containers

# --- Access tier (optional) ---
# Ceiling on what the companion may do. administrator = tools + run_shell + code mode,
# mid = tools + run_shell, entry = tools only, nothing = no tools. Unattended turns
# (idle talk, background, scheduled) are always capped at entry. Also: /set access_level
# ACCESS_LEVEL=administrator

# --- API secrets (optional, but set them on any host other machines can reach) ---
# Required on every /admin/* route as header X-Admin-Key. Empty = /admin/* is open.
# Must equal AVATAR_ADMIN_KEY in the telegram-bot .env.
# ADMIN_KEY=
# Exact browser origins allowed to call this API (comma-separated). Empty = no
# cross-origin browser client is allowed to call this API.
# CORS_ORIGINS=

# --- Telegram Push Notifications ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- FreshRSS (optional) ---
# FRESHRSS_ENABLED=true
# FRESHRSS_URL=http://your-server:8091
# FRESHRSS_USER=your_username
# FRESHRSS_API_PASSWORD=your_api_password

# --- Nextcloud Calendar (optional) ---
# NEXTCLOUD_ENABLED=true
# NEXTCLOUD_CALDAV_URL=http://your-server:8082/remote.php/dav
# NEXTCLOUD_USER=your_username
# NEXTCLOUD_PASSWORD=your_password
# NEXTCLOUD_CALENDAR_NAME=personal

# --- Weather fallback coords (used when IP geolocation fails) ---
# WEATHER_LAT=0.0
# WEATHER_LON=0.0
# WEATHER_LOCATION_NAME=Your City

# --- Feature Toggles ---
# TTS_ENABLED=true
# STT_ENABLED=true
# STICKER_ENABLED=true
# STICKER_CHANCE=0.5
# TOUCH_ENABLED=false
# MOOD_ENABLED=true
# IDLE_TALK_INTERVAL_HOURS=0.5
# BACKGROUND_POLL_SECONDS=60                       # legacy name: TASK_REMINDER_POLL_SECONDS

# --- Optional companion services (dashboard / avatar-phone) ---
# AVATAR_PHONE_URL=            # external avatar-phone service; leave empty to disable
# TRACKED_APPS=                # JSON list for the dashboard, e.g. [{"name":"app","path":"/abs/path"}]

# --- Rotating site passwords (password plugin) ---
# Shared secret for daily per-site password derivation. MUST be identical across
# the Cloudflare Worker, telegram-bot, and password-recovery app. 32 random bytes
# hex, e.g. `openssl rand -hex 32`. Changing it rotates/resets every password.
# GATE_SECRET=
